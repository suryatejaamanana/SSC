ENVIRONMENT=development

# Async SQLAlchemy URL (asyncpg driver). When running via docker-compose, host is
# the service name "db"; when running natively against the local Postgres
# install, use "localhost".
DATABASE_URL=postgresql+asyncpg://ssc_cgl:change_me@localhost:5432/ssc_cgl

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Secure=True requires HTTPS - keep false for local http://localhost dev,
# set true in production once served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Where PDF-import files (original PDFs, cropped question/option images) are
# stored. Served only through authenticated routes - never a static directory.
#   local = filesystem under MEDIA_ROOT (default for dev)
#   b2    = private Backblaze B2 bucket (production)
MEDIA_BACKEND=local
MEDIA_ROOT=./media
MAX_UPLOAD_MB=20

# Only read when MEDIA_BACKEND=b2. Keep the bucket PRIVATE. Use an application
# key restricted to this one bucket. Never commit real values.
# B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_KEY_PREFIX=

# false disables POST /api/v1/admin/imports (used on the 512MB Render free
# instance; run backend/scripts/import_paper.py locally instead).
IMPORTS_ENABLED=true

# Neon note: paste Neon's DIRECT connection string as-is. ?sslmode=require and
# &channel_binding=require are translated/dropped automatically for asyncpg.
